<Window x:Class="Wpf_animatsiya_42.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_animatsiya_42"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
    Loaded="Window_Loaded">

    <Grid>
        <StackPanel Orientation="Horizontal">
            <StackPanel Width="200">
                <StackPanel Height="300" >
                    
                    <Image Source="/rasm1.jpg" Width="100" Height="100" 
          Margin="0,100,0,20"  RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                    </Image>
                    
                </StackPanel>
                <StackPanel>
                    <Button Height="50" Width="100" 
                            VerticalAlignment="Center"  
                            Click="Kattalashtirish_Animatsiyasi"> Kattalashtir</Button>
                    <Button Height="50" Width="100" 
        VerticalAlignment="Center"  
        Click="Kattalashtirish_Animatsiyasi1">Kattalashtir</Button>
                    <Button Height="50" Width="100" 
        VerticalAlignment="Center"  
        Click="Kattalashtirish_Animatsiyasi_Stop">Kattalashtir</Button>
                </StackPanel>
                    
            </StackPanel>
            <StackPanel>
                <StackPanel Height="100" Width="600">
                   <Canvas>
                    <TextBlock x:Name="Matn" Text="Assalomu alaykum!" 
       FontSize="24" FontWeight="Bold" 
       Canvas.Top="10" />
                </Canvas>  
                </StackPanel>
                <StackPanel Height="300">
                    <Rectangle x:Name="Tortburchak" Width="400" Height="300">
                        <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="Red" Offset="0"/>
                                <GradientStop Color="Green" Offset="1"/>
                            </LinearGradientBrush> 
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Window>
